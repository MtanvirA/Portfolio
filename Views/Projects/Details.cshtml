@model Portfolio.ViewModels.ProjectDetailViewModel
@{
    var project = Model.Project;
    ViewData["Title"] = $"{project.Title} — Case Study";
    ViewData["Description"] = $"{project.Title}: {project.Tagline}. {project.ShortDescription}";
    ViewData["CanonicalUrl"] = $"{Model.Options.CanonicalDomain}/projects/{project.Slug}";
}

<article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    
    <!-- Breadcrumb & Back -->
    <nav class="flex items-center justify-between text-xs font-mono-code text-slate-400" aria-label="Breadcrumb">
        <div class="flex items-center gap-2">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span>/</span>
            <a href="/projects" class="hover:text-white transition-colors">Projects</a>
            <span>/</span>
            <span class="text-[#d4ff3a]">@project.Title</span>
        </div>
        <a href="/#projects" class="inline-flex items-center gap-1.5 text-slate-400 hover:text-white transition-colors">
            &larr; Back to all projects
        </a>
    </nav>

    <!-- Case Study Header -->
    <header class="space-y-4 border-b border-[#212836] pb-8">
        <div class="flex flex-wrap items-center gap-3">
            <span class="px-3 py-1 rounded-full bg-[#161c26] border border-[#252f3f] text-xs font-mono-code text-[#38bdf8]">
                @project.Category
            </span>
            <span class="px-3 py-1 rounded-full bg-[#16221c] border border-[#224432] text-xs font-mono-code text-[#4ade80]">
                @project.Status
            </span>
        </div>

        <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-white tracking-tight">
            @project.Title
        </h1>
        
        <p class="font-mono-code text-base sm:text-lg text-slate-300">
            @project.Tagline
        </p>

        <!-- Metadata Ribbon -->
        <div class="flex flex-wrap items-center gap-6 pt-4 text-xs font-mono-code text-slate-400">
            <div>
                <span class="text-slate-500 block">ROLE / CONTRIBUTION</span>
                <span class="text-slate-200">Software Architecture &amp; Implementation</span>
            </div>
            <div>
                <span class="text-slate-500 block">INSTITUTION</span>
                <span class="text-slate-200">PSTU CSE Department</span>
            </div>
            @if (!string.IsNullOrEmpty(project.RepositoryUrl))
            {
                <div class="ml-auto">
                    <a href="@project.RepositoryUrl" target="_blank" rel="noopener noreferrer" 
                       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#141822] hover:bg-[#1b2230] text-slate-200 hover:text-white border border-[#232a36] transition-colors">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path></svg>
                        <span>View Repository</span>
                    </a>
                </div>
            }
        </div>
    </header>

    <!-- Visual Banner / Technical Architecture Diagram -->
    <div class="rounded-2xl overflow-hidden border border-[#212836] bg-[#0c0f16] shadow-2xl">
        <img src="@project.ImageUrl" 
             alt="@project.Title Technical Overview" 
             class="w-full h-auto object-cover" />
    </div>

    <!-- Verified Tech Stack Badges -->
    <div class="p-6 rounded-2xl bg-[#10141d] border border-[#212836] space-y-3">
        <h2 class="font-mono-code text-xs text-[#d4ff3a] uppercase font-semibold">Verified Technologies Used</h2>
        <div class="flex flex-wrap gap-2">
            @foreach (var tech in project.Technologies)
            {
                <span class="px-3 py-1.5 rounded-lg bg-[#151c27] border border-[#243144] font-mono-code text-xs text-slate-200">
                    @tech
                </span>
            }
        </div>
    </div>

    <!-- Detailed Narrative Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-slate-300 leading-relaxed text-sm sm:text-base">
        
        <!-- Problem Statement -->
        <section class="p-6 sm:p-8 rounded-2xl bg-[#10141d] border border-[#212836] space-y-3">
            <div class="flex items-center gap-2 text-rose-400 font-mono-code text-xs uppercase font-bold">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <span>Problem Being Solved</span>
            </div>
            <h3 class="font-display font-bold text-xl text-white">The Challenge</h3>
            <p>@project.ProblemStatement</p>
        </section>

        <!-- Solution Overview -->
        <section class="p-6 sm:p-8 rounded-2xl bg-[#10141d] border border-[#212836] space-y-3">
            <div class="flex items-center gap-2 text-emerald-400 font-mono-code text-xs uppercase font-bold">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>Engineering Solution</span>
            </div>
            <h3 class="font-display font-bold text-xl text-white">The Approach</h3>
            <p>@project.SolutionOverview</p>
        </section>

        <!-- Architecture & Decisions -->
        <section class="p-6 sm:p-8 rounded-2xl bg-[#10141d] border border-[#212836] space-y-3">
            <div class="flex items-center gap-2 text-[#38bdf8] font-mono-code text-xs uppercase font-bold">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                <span>Architecture &amp; Decisions</span>
            </div>
            <h3 class="font-display font-bold text-xl text-white">System Architecture</h3>
            <p>@project.ArchitectureNotes</p>
            <p class="pt-2 text-xs font-mono-code text-slate-400">@project.EngineeringDecisions</p>
        </section>

        <!-- Contribution & Academic Context -->
        <section class="p-6 sm:p-8 rounded-2xl bg-[#10141d] border border-[#212836] space-y-3">
            <div class="flex items-center gap-2 text-[#d4ff3a] font-mono-code text-xs uppercase font-bold">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                <span>Contribution &amp; Scope</span>
            </div>
            <h3 class="font-display font-bold text-xl text-white">My Work &amp; Current Limitations</h3>
            <p>@project.Contribution</p>
            <div class="p-3 rounded-lg bg-[#161c26] border border-[#232f3f] text-xs font-mono-code text-slate-400 mt-3">
                <strong class="text-slate-300">Current Scope:</strong> @project.CurrentLimitations
            </div>
        </section>

    </div>

    <!-- Adjacent Project Navigation -->
    <footer class="pt-12 border-t border-[#212836] grid grid-cols-1 sm:grid-cols-2 gap-4">
        @if (Model.PreviousProject != null)
        {
            <a asp-controller="Projects" asp-action="Details" asp-route-slug="@Model.PreviousProject.Slug"
               class="p-4 rounded-xl bg-[#10141d] border border-[#212836] hover:border-slate-500 transition-colors flex items-center gap-3 group">
                <span class="text-slate-500 group-hover:text-[#d4ff3a]">&larr;</span>
                <div>
                    <span class="text-[11px] font-mono-code text-slate-500 block">PREVIOUS PROJECT</span>
                    <span class="text-sm font-bold text-white group-hover:text-[#d4ff3a] transition-colors">@Model.PreviousProject.Title</span>
                </div>
            </a>
        }
        else
        {
            <div></div>
        }

        @if (Model.NextProject != null)
        {
            <a asp-controller="Projects" asp-action="Details" asp-route-slug="@Model.NextProject.Slug"
               class="p-4 rounded-xl bg-[#10141d] border border-[#212836] hover:border-slate-500 transition-colors flex items-center justify-end gap-3 text-right group sm:col-start-2">
                <div>
                    <span class="text-[11px] font-mono-code text-slate-500 block">NEXT PROJECT</span>
                    <span class="text-sm font-bold text-white group-hover:text-[#d4ff3a] transition-colors">@Model.NextProject.Title</span>
                </div>
                <span class="text-slate-500 group-hover:text-[#d4ff3a]">&rarr;</span>
            </a>
        }
    </footer>

</article>
