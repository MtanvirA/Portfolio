@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="min-h-[70vh] flex items-center justify-center px-4 py-24">
    <div class="max-w-lg w-full text-center space-y-6 p-8 rounded-2xl bg-[#10141d] border border-rose-900/40 shadow-2xl">
        <div class="inline-flex p-3 rounded-full bg-rose-500/10 text-rose-400">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        
        <div class="space-y-2">
            <h1 class="font-display font-bold text-2xl text-white">Application Exception</h1>
            <p class="text-sm text-slate-400">
                An unexpected error occurred while processing your request. The issue has been safely recorded in server diagnostics.
            </p>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="p-3 rounded-lg bg-[#090b10] border border-[#1f2735] font-mono-code text-xs text-slate-400">
                <span>Correlation Trace ID:</span>
                <span class="text-slate-200 select-all block mt-1">@Model.RequestId</span>
            </div>
        }

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-[#d4ff3a] text-[#090a0f] font-bold text-xs uppercase tracking-wider transition-colors hover:bg-[#c2ed2c]">
                Return Home
            </a>
            <a href="mailto:tanviranjum201@gmail.com" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-[#141822] text-slate-300 hover:text-white border border-[#232a36] text-xs font-mono-code transition-colors">
                Report Issue
            </a>
        </div>
    </div>
</div>
